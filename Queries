select * from customer limit 4;
select lower(first_name), lower(last_name), lower(email) from customer
where length(first_name) > 10 or length(last_name) > 10;

select lower(right(email, 5)) from customer limit 5;
select lower(left(right(email, 4),1)) from customer limit 5;

select * from customer limit 4;
select left(first_name, 1) || '***' || right(email, 19) as anonimo from customer limit 5;

select email from customer limit 4;
select last_name || ', ' || left(email, position('.' in email) -1)  from customer limit 5;

select email from customer limit 4;
select left(email, 1) || '***' || substring( email, position('.' in email), 2) || '***' || right(email, 19) from customer limit 6;
select '***' || substring( email, position('.' in email)-1, 0 ) || substring( email, position('.' in email), 2) || '***' || right(email, 19) from customer limit 5;

select  extract(week from payment_date) as WEEK, customer_id, sum(amount) from payment
group by customer_id, extract(week from payment_date) order by 3 desc limit 4;

select sum(amount) as amount, to_char(payment_date,'Mon, YYYY') as date from payment group by date order by 1 limit 2;
select sum(amount) as total_amount, to_char(payment_date, 'Dy, dd/mm/yyyy') as date from payment group by date order by total_amount limit 2;
select sum(amount) as total_amount, to_char(payment_date, 'Dy, HH:MI') as date from payment group by date order by 1 desc limit 2;

select * from rental limit 4;
select customer_id,  return_date - rental_date as rental_duration from rental where customer_id = 35;

select customer_id,  avg(return_date - rental_date) as Average_rental_duration from rental
group by customer_id order by 2 desc limit 5;

